# Скопируй файл в .env.local и заполни значения.
# Лендинг работает и без них: ИИ-ассистент в этом случае отвечает подсказкой о настройке.

# Публичный адрес сайта (без слэша в конце). Локально: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Необязательно: CDN для видео лендинга (файлы ищутся в <URL>/videos/). Пусто — берутся из /public/videos.
NEXT_PUBLIC_MEDIA_URL=

# --- ИИ-ассистент (любой OpenAI-совместимый API: DeepSeek, OpenRouter, агрегаторы с оплатой в рублях и т.д.) ---
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# Доп. параметры тела запроса (JSON). Для DeepSeek отключаем «размышления»: быстрее и дешевле.
# Для других провайдеров оставь пустым.
AI_EXTRA_BODY={"thinking":{"type":"disabled"}}
# Ассистент доступен только с IDX PRO. Лимит сообщений в сутки на один аккаунт
CHAT_USER_DAILY_LIMIT=100
# Лимит сообщений в сутки с одного IP (несколько аккаунтов за одним адресом; учёт в памяти сервера, src/lib/server/rate-limit.ts)
CHAT_DAILY_LIMIT=300
# Общий лимит сообщений в сутки на весь сайт: потолок расходов на API при любых IP
CHAT_GLOBAL_DAILY_LIMIT=1500
# Сколько reverse proxy перед сайтом дописывают X-Forwarded-For (обычно один nginx). 0 — брать только X-Real-IP
TRUSTED_PROXY_HOPS=1

# --- Аккаунты (src/lib/server/auth.ts) ---
# Подписывает сессии и cookie. В продакшене обязателен, 32+ символа: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Файл базы SQLite (аккаунты, доступы, промокоды), путь от корня проекта. Не коммить, делай резервные копии
DATABASE_PATH=data/ideluxe.sqlite
# Вход через Google (необязательно): OAuth-клиент в Google Cloud Console,
# redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Вход через Telegram (необязательно): @BotFather → бот → Login Widget. Там же разреши адреса:
# сам сайт <NEXT_PUBLIC_SITE_URL> и возврат <NEXT_PUBLIC_SITE_URL>/api/auth/callback/telegram
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Аккаунты с полным доступом (владелец, тестировщики), email через запятую
ADMIN_EMAILS=
# Ключ для /api/internal/* (бот выдаёт доступ и промокоды), 32+ символа. Пусто — эти адреса выключены
INTERNAL_API_SECRET=

# --- Почта (src/lib/server/mail.ts) ---
# Нужна для подтверждения email при регистрации и восстановления пароля.
# Пусто — письма не отправляются, подтверждение адреса отключается, аккаунт входит сразу.
# Любой SMTP: Яндекс 360, Mail.ru для бизнеса, Unisender Go, SendPulse.
SMTP_HOST=
# 465 — TLS сразу, 587 — STARTTLS
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Отправитель, например: IDELUXE STUDIO <no-reply@example.ru>. Пусто — берётся SMTP_USER
MAIL_FROM=
# Куда попадут ответы на письма, если отличается от отправителя
MAIL_REPLY_TO=
